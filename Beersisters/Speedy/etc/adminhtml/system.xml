<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="bsspeedy" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Speedy (Beersisters)</label>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Title</label>
                </field>
                <field id="name_office" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>To office/automat: method name</label>
                </field>
                <field id="price_office" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>To office/automat: price (EUR)</label>
                    <comment>Entered like the other shipping prices (Tax → Shipping Prices).</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
                <field id="name_address" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>To address: method name</label>
                </field>
                <field id="price_address" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>To address: price (EUR)</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
                <field id="api_username" translate="label" type="text" sortOrder="100" showInDefault="1">
                    <label>Speedy API username</label>
                </field>
                <field id="api_password" translate="label comment" type="obscure" sortOrder="110" showInDefault="1">
                    <label>Speedy API password</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. The module only ever calls Speedy's /location/ endpoints.</comment>
                </field>
                <field id="sync_enabled" translate="label comment" type="select" sortOrder="120" showInDefault="1" canRestore="1">
                    <label>Daily location sync</label>
                    <comment>Downloads Speedy's sites and offices at 04:15. Manual run: bin/magento beersisters:speedy:sync</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="sallowspecific" translate="label" type="select" sortOrder="200" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Ship to Applicable Countries</label>
                    <frontend_class>shipping-applicable-country</frontend_class>
                    <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="210" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Ship to Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="showmethod" translate="label" type="select" sortOrder="220" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Show Method if Not Applicable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="230" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Sort Order</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
            </group>
        </section>
    </system>
</config>
