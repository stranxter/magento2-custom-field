<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="shipping-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="shippingAddress" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <!-- Rendered right after the guest e-mail field, i.e. before the address
                                                             form and before the saved-address cards (SPEEDY-PLAN.md §3.5). -->
                                                        <item name="bsspeedy" xsi:type="array">
                                                            <item name="component" xsi:type="string">Beersisters_Speedy/js/view/speedy</item>
                                                            <item name="displayArea" xsi:type="string">customer-email</item>
                                                            <item name="sortOrder" xsi:type="string">100</item>
                                                            <item name="config" xsi:type="array">
                                                                <item name="siteUrl" xsi:type="url" path="bsspeedy/lookup/site"/>
                                                                <item name="officeUrl" xsi:type="url" path="bsspeedy/lookup/office"/>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
